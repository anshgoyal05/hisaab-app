# Database configuration (PostgreSQL 16)
DATABASE_URL="postgresql://hisaab_user:hisaab_secure_pass@localhost:5432/hisaab_db?schema=public"

# Server configuration
PORT=4000
NODE_ENV=development
API_HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5173"

# Authentication Secrets (Generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET="dev_access_jwt_secret_change_in_production_min32chars"
JWT_REFRESH_SECRET="dev_refresh_jwt_secret_change_in_production_min32chars"
COOKIE_SECRET="dev_cookie_secret_change_in_production_min32chars"

# Master Encryption Key (KEK) for Envelope Encryption
# 256-bit AES key as 64-character hex string (Generate with: openssl rand -hex 32)
# In production, retrieve this from AWS KMS / GCP Secret Manager / HashiCorp Vault.
APP_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Optional Previous Master Key for Key Rotation grace period
# APP_MASTER_KEY_PREVIOUS=""

# Web Client URL
VITE_API_BASE_URL="http://localhost:4000/api/v1"
